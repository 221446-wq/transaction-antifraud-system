# Dirección(es) del broker de Kafka. Si hay más de uno, separarlos por coma
# (ej: "kafka1:9092,kafka2:9092"). Con el docker-compose.yml de la raíz:
KAFKA_BROKERS=localhost:9092

# Identificador de este servicio ante Kafka (útil para logs y monitoreo
# del lado del broker). Opcional, tiene un valor por defecto en el código.
KAFKA_CLIENT_ID=antifraud-service

# groupId del consumer de Kafka. Opcional, tiene un valor por defecto en el
# código; se documenta acá porque cambiarlo hace que el servicio vuelva a
# leer los tópicos desde donde ese grupo nunca los haya consumido.
KAFKA_CONSUMER_GROUP_ID=antifraud-service
