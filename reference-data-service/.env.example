# Cadena de conexión a PostgreSQL. Usa la misma base que transaction-service
# (transactions_db) pero sus propias tablas (reference_rate_sources,
# reference_rates) — ver src/db/schema.sql. Con el docker-compose.yml de la
# raíz del proyecto, este valor coincide con:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transactions_db

# Página HTML pública desde la que se recolectan las tasas de cambio de
# referencia (BCE — Banco Central Europeo). Es un dato de referencia
# independiente, no afecta la regla de negocio antifraude — ver
# docs/WEB_SCRAPING.md.
SOURCE_URL=https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html

# Puerto del servidor HTTP: expone /health, /metrics, y una consulta de
# solo lectura de las tasas recolectadas (GET /reference-rates).
PORT=3002

# --- Opcionales, todas tienen un valor por defecto razonable en el código ---

# Cada cuánto se intenta una nueva recolección.
POLL_INTERVAL_MS=1800000

# Timeout de la request HTTP a la fuente, y política de reintentos con
# backoff ante fallos transitorios (timeout, 5xx, error de red).
FETCH_TIMEOUT_MS=10000
FETCH_RETRIES=3
FETCH_RETRY_INITIAL_DELAY_MS=500

# Intervalo mínimo entre dos requests al mismo host (rate limiting por
# host) — ver src/http/hostRateLimiter.js.
MIN_INTERVAL_PER_HOST_MS=5000

LOG_LEVEL=info
LOG_PRETTY=true
