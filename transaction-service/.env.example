# Puerto en el que arranca el servidor HTTP de transaction-service.
PORT=3000

# Cadena de conexión a PostgreSQL, en formato:
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# Con el docker-compose.yml de la raíz del proyecto, estos valores coinciden con:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transactions_db

# Dirección(es) del broker de Kafka. Si hay más de uno, separarlos por coma
# (ej: "kafka1:9092,kafka2:9092"). Con el docker-compose.yml de la raíz:
KAFKA_BROKERS=localhost:9092

# Identificador de este servicio ante Kafka (útil para logs y monitoreo
# del lado del broker). Opcional, tiene un valor por defecto en el código.
KAFKA_CLIENT_ID=transaction-service

# --- Opcionales, todas tienen un valor por defecto razonable en el código ---

# Tamaño máximo del pool de conexiones a Postgres (pg.Pool). Ver
# docs/HIGH_VOLUME.md para el criterio de dimensionamiento.
DATABASE_POOL_MAX=10

# Cada cuánto el relay del outbox revisa si hay eventos pendientes de
# publicar, cuántos toma por ciclo, y tras cuántos intentos fallidos
# consecutivos manda un evento a la DLQ en vez de seguir reintentando. Ver
# DECISIONS.md, "Patrón Outbox".
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10

# Nivel de log (pino): trace|debug|info|warn|error|fatal.
LOG_LEVEL=info
# En desarrollo, imprime los logs coloreados y legibles en vez de JSON crudo.
LOG_PRETTY=true
