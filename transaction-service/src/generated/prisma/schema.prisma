// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionStatus {
  pending
  approved
  rejected
}

model TransactionType {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  transactions Transaction[]

  @@map("transaction_types")
}

model Transaction {
  id                      Int               @id @default(autoincrement())
  externalId              String            @unique @default(uuid()) @map("external_id") @db.Uuid
  accountExternalIdDebit  String            @map("account_external_id_debit") @db.Uuid
  accountExternalIdCredit String            @map("account_external_id_credit") @db.Uuid
  transferTypeId          Int               @map("transfer_type_id")
  transferType            TransactionType   @relation(fields: [transferTypeId], references: [id])
  value                   Decimal           @db.Decimal(18, 2)
  status                  TransactionStatus @default(pending)
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  @@map("transactions")
}

// Patrón Outbox: la fila se inserta en la misma transacción de Postgres que
// el INSERT de negocio (ver transactionService.js), así que "guardado en la
// base" y "hay un evento pendiente de publicar" quedan atómicos entre sí. Un
// proceso aparte (outboxRelay.js) es el único que lee esta tabla y publica a
// Kafka — ver DECISIONS.md.
model OutboxEvent {
  id             Int       @id @default(autoincrement())
  eventId        String    @unique @default(uuid()) @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  deadLetteredAt DateTime? @map("dead_lettered_at")

  @@index([publishedAt, deadLetteredAt, id])
  @@map("outbox_events")
}
